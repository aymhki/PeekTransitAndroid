        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${GOOGLE_MAPS_API_KEY}" />

        <meta-data
            android:name="GOOGLE_PLACES_API_KEY"
            android:value="${GOOGLE_PLACES_API_KEY}" />

        <meta-data
            android:name="TRANSIT_API_KEY"
            android:value="${TRANSIT_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PeekTransit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widgets.PeekTransitSmallWidgetConfigurationActivity"
            android:exported="true"
